<Project><PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><NuGetLockFilePath Condition="'$(PortableBuild)' == 'true'">$(MSBuildProjectDirectory)/packages.portable.lock.json</NuGetLockFilePath></PropertyGroup></Project>
