+static void jk_configure_interval(winrt_capture *capture, const winrt::Windows::Graphics::Capture::GraphicsCaptureSession &session)
+{
+	if (!winrt::Windows::Foundation::Metadata::ApiInformation::IsPropertyPresent(L"Windows.Graphics.Capture.GraphicsCaptureSession", L"MinUpdateInterval")) return;
+	capture->jk_original_interval_ns = session.MinUpdateInterval().count() * 100;
+	wchar_t requested[16]{};
+	int milliseconds = 4; // A minimum update hint, not a promised capture frame rate.
+	if (GetEnvironmentVariableW(L"JKILLER_WGC_INTERVAL_MS", requested, 16)) {
+		const auto experiment = _wtoi(requested);
+		if (experiment >= 0 && experiment <= 16) milliseconds = experiment;
+	}
+	session.MinUpdateInterval(winrt::Windows::Foundation::TimeSpan{milliseconds * 10000LL});
+	capture->jk_actual_interval_ns = session.MinUpdateInterval().count() * 100;
+}
