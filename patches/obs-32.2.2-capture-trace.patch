 extern "C" EXPORT BOOL winrt_capture_supported()
 try {
@@ -117,6 +118,8 @@ struct winrt_capture {
 	D3D11_BOX client_box;
 
 	BOOL active;
+	uint64_t jk_sequence = 0;
+	uint64_t jk_texture_acquired_ns = 0;
 	struct winrt_capture *next;
 
 	void on_closed(winrt::Windows::Graphics::Capture::GraphicsCaptureItem const &,
@@ -175,6 +178,8 @@ struct winrt_capture {
 				}
 
 				texture_written = true;
+				++jk_sequence;
