+// Caller holds the OBS graphics lock, as for the existing texture queries.
+extern "C" EXPORT BOOL winrt_capture_get_frame_info(const winrt_capture *capture, uint64_t *sequence, uint64_t *ns)
+{
+	if (!capture || !sequence || !ns || !capture->texture_written)
+		return FALSE;
+	*sequence = capture->jk_sequence;
+	*ns = capture->jk_texture_acquired_ns;
+	return TRUE;
+}
+
+extern "C" EXPORT BOOL winrt_capture_get_update_interval(const winrt_capture *capture, int64_t *original_ns, int64_t *actual_ns)
+{
+	if (!capture || !original_ns || !actual_ns || capture->jk_actual_interval_ns < 0) return FALSE;
+	*original_ns = capture->jk_original_interval_ns; *actual_ns = capture->jk_actual_interval_ns; return TRUE;
+}
