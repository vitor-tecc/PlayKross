<Application x:Class="JKiller.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PlayKrossBlue" Color="#6a94c5"/>
    <SolidColorBrush x:Key="PlayKrossYellow" Color="#FFDE5A"/>
    <SolidColorBrush x:Key="PlayKrossInk" Color="#152647"/>
    <Style TargetType="Window"><Setter Property="Background" Value="#0E182A"/><Setter Property="Foreground" Value="#EDF2F7"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Background" Value="{StaticResource PlayKrossYellow}"/><Setter Property="Foreground" Value="{StaticResource PlayKrossInk}"/><Setter Property="BorderBrush" Value="{StaticResource PlayKrossBlue}"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="#F3F7FC"/><Setter Property="Foreground" Value="{StaticResource PlayKrossInk}"/><Setter Property="BorderBrush" Value="{StaticResource PlayKrossBlue}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="{StaticResource PlayKrossInk}"/><Setter Property="BorderBrush" Value="{StaticResource PlayKrossBlue}"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF2F7"/></Style>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="{StaticResource PlayKrossBlue}"/></Style>
  </Application.Resources>
</Application>
