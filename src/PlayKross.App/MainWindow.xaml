<Window x:Class="PlayKross.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PlayKross.App.Localization" xmlns:controls="clr-namespace:PlayKross.App.Controls" Style="{StaticResource PlayKrossWindowStyle}" Background="{StaticResource PlayKrossPageBrush}" Title="{DynamicResource Text0}" Icon="Assets/playkross-logo.png" Width="1180" Height="840" MinWidth="900" MinHeight="620" Closing="WindowClosing">
  <Window.Resources>
    <local:TranslationConverter x:Key="Translate"/>
    <!-- Room/broadcast state shown in the header and action bar. -->
    <Style x:Key="StatePill" TargetType="Border">
      <Setter Property="CornerRadius" Value="999"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,12,0"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#0FFFFFFF"/><Setter Property="BorderBrush" Value="{StaticResource PlayKrossLine}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsJoined}" Value="True"><Setter Property="BorderBrush" Value="#335FD08A"/></DataTrigger>
        <DataTrigger Binding="{Binding CaptureLive}" Value="True"><Setter Property="Background" Value="#33C2283B"/><Setter Property="BorderBrush" Value="#93404F"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StateDot" TargetType="Ellipse">
      <Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Fill" Value="{StaticResource PlayKrossMuted}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsJoined}" Value="True"><Setter Property="Fill" Value="{StaticResource PlayKrossOk}"/></DataTrigger>
        <DataTrigger Binding="{Binding CaptureLive}" Value="True"><Setter Property="Fill" Value="{StaticResource PlayKrossLive}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StateText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{StaticResource PlayKrossTextSoft}"/><Setter Property="Text" Value="{DynamicResource Text38}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsJoined}" Value="True"><Setter Property="Text" Value="{DynamicResource Text37}"/></DataTrigger>
        <DataTrigger Binding="{Binding CaptureLive}" Value="True"><Setter Property="Text" Value="{DynamicResource Text36}"/><Setter Property="Foreground" Value="#FFD9DE"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Padding="24,14" Background="#CC0E182A" BorderBrush="{StaticResource PlayKrossLine}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Image Source="Assets/playkross-logo.png" Width="46" Height="46" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"><Image.Effect><DropShadowEffect Color="#6A94C5" Opacity="0.35" BlurRadius="16" ShadowDepth="2" Direction="270"/></Image.Effect></Image>
          <StackPanel VerticalAlignment="Center"><TextBlock FontSize="21" FontWeight="Bold" Foreground="{StaticResource PlayKrossYellow}" Text="PlayKross"/><TextBlock FontSize="12.5" Foreground="{StaticResource PlayKrossMuted}" Text="{DynamicResource Text1}"/></StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Style="{StaticResource StatePill}"><StackPanel Orientation="Horizontal"><Ellipse Style="{StaticResource StateDot}"/><TextBlock Style="{StaticResource StateText}"/></StackPanel></Border>
          <ComboBox x:Name="LanguagePicker" Width="160" AutomationProperties.Name="Idioma / Language" SelectedValuePath="Tag" SelectionChanged="LanguageChanged"><ComboBoxItem Content="Português (BR)" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <Grid Margin="24,22,24,8" MaxWidth="1320">
        <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <!-- Room -->
          <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <StackPanel>
              <Border Height="3" Background="{StaticResource PlayKrossAccentLine}" CornerRadius="14,14,0,0"/>
              <StackPanel x:Name="ConnectionControls" Margin="20,16,20,12">
                <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Text31}"/>
                <TextBlock Style="{StaticResource CardSubtitle}" Text="{DynamicResource Text2}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="{DynamicResource Text3}"/>
                <TextBox x:Name="Link" AutomationProperties.AutomationId="RoomLink" Text="{Binding RoomLink, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Text4}"/>
                <TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"/>
                <Button x:Name="JoinButton" Style="{StaticResource PrimaryButton}" Margin="0,18,0,8" MinHeight="42" Content="{DynamicResource Text5}" Click="JoinClick"/>
                <Button Margin="0,0,0,8" MinHeight="40" Content="{DynamicResource Text10}" Click="WatchClick"/>
                <UniformGrid Columns="2" Margin="0,0,-8,0">
                  <Button Content="{DynamicResource Text7}" Click="RenameClick"/>
                  <Button Content="{DynamicResource Text8}" Click="CopyClick"/>
                  <Button Content="{DynamicResource Text9}" Click="ViewClick"/>
                  <Button Style="{StaticResource QuietButton}" Content="{DynamicResource Text6}" Click="LeaveClick" IsEnabled="{Binding IsJoined}"/>
                </UniformGrid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Broadcast details -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Text35}"/>
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource PlayKrossTextSoft}" LineHeight="19"><TextBlock.Text><MultiBinding Converter="{StaticResource Translate}"><Binding Path="AppliedText"/><Binding Source="{x:Static local:Language.Current}" Path="Selected"/></MultiBinding></TextBlock.Text></TextBlock>
              <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="9" Background="#0C1626" BorderBrush="{StaticResource PlayKrossLine}" BorderThickness="1">
                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{StaticResource PlayKrossMuted}"><TextBlock.Text><MultiBinding Converter="{StaticResource Translate}"><Binding Path="ObservedText"/><Binding Source="{x:Static local:Language.Current}" Path="Selected"/></MultiBinding></TextBlock.Text></TextBlock>
              </Border>
              <Button HorizontalAlignment="Left" Margin="0,14,0,0" Content="{DynamicResource Text29}" Click="ExportClick"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0" Text="{DynamicResource Text30}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <!-- What to share -->
          <Border Style="{StaticResource Card}">
            <StackPanel x:Name="SelectionControls">
              <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Text33}"/>
              <TextBlock Style="{StaticResource CardSubtitle}" Text="{DynamicResource Text11}"/>
              <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="{DynamicResource Text12}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="VideoSource" AutomationProperties.AutomationId="VideoSource" ItemsSource="{Binding Sources}" DisplayMemberPath="DisplayName" SelectedItem="{Binding Video}"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Content="{DynamicResource Text13}" Click="RefreshClick"/>
              </Grid>
              <Border Style="{StaticResource Divider}"/>
              <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Text14}"/>
              <ComboBox x:Name="AudioModePicker" SelectedIndex="0" SelectionChanged="AudioModeChanged"><ComboBoxItem Content="{DynamicResource Text15}" Tag="Off"/><ComboBoxItem Content="{DynamicResource Text16}" Tag="Application"/><ComboBoxItem Content="{DynamicResource Text17}" Tag="SystemOutput"/></ComboBox>
              <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{DynamicResource Text18}"/>
                <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" VerticalAlignment="Bottom" TextWrapping="Wrap" Text="{DynamicResource Text19}"/>
                <ComboBox x:Name="AudioSource" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding AudioApplications}" DisplayMemberPath="DisplayName" SelectionChanged="AudioChanged" IsEnabled="False"/>
                <controls:AudioOutputPicker x:Name="AudioOutput" Grid.Row="1" Grid.Column="2" Style="{StaticResource {x:Type ComboBox}}" IsEnabled="False"/>
              </Grid>
              <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFDE9C"><TextBlock.Text><MultiBinding Converter="{StaticResource Translate}"><Binding Path="AudioEligibility.Reason"/><Binding Source="{x:Static local:Language.Current}" Path="Selected"/></MultiBinding></TextBlock.Text></TextBlock>
              <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Text20}"/>
              <Border Style="{StaticResource Divider}"/>
              <CheckBox x:Name="CpuFallbackChoice" Margin="0,10,0,0" IsChecked="{Binding AllowCpuFallback}" Content="{DynamicResource Text21}" ToolTip="{DynamicResource Text22}"/>
            </StackPanel>
          </Border>

          <!-- Quality -->
          <Border Style="{StaticResource Card}">
            <StackPanel x:Name="SettingsControls">
              <TextBlock Style="{StaticResource CardTitle}" Text="{DynamicResource Text34}"/>
              <TextBlock Style="{StaticResource CardSubtitle}" Text="{DynamicResource Text23}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="Resolution" SelectedIndex="2" SelectionChanged="PresetChanged"><ComboBoxItem Content="480p" Tag="480"/><ComboBoxItem Content="720p" Tag="720"/><ComboBoxItem Content="1080p" Tag="1080"/></ComboBox>
                <ComboBox x:Name="Fps" Grid.Column="2" SelectedIndex="1" SelectionChanged="PresetChanged"><ComboBoxItem Content="30 FPS" Tag="30"/><ComboBoxItem Content="60 FPS" Tag="60"/></ComboBox>
              </Grid>
              <TextBlock x:Name="BitrateLabel" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" Text="{DynamicResource Text24}"/>
              <Slider x:Name="Bitrate" Minimum="1" Maximum="25" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="15" ValueChanged="BitrateChanged"/>
              <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource Text25}"/>
              <Button Margin="0,14,0,0" HorizontalAlignment="Left" Content="{DynamicResource Text26}" Click="ApplyClick"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- Action bar -->
    <Border Grid.Row="2" Padding="24,14" Background="#F20B1424" BorderBrush="{StaticResource PlayKrossLine}" BorderThickness="0,1,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" MinWidth="210" MinHeight="46" FontSize="15" Margin="0,0,10,0" Content="{DynamicResource Text27}" Click="StartClick"/>
          <Button Style="{StaticResource DangerButton}" MinWidth="150" MinHeight="46" Margin="0,0,20,0" Content="{DynamicResource Text28}" Click="StopClick"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Style="{StaticResource StateDot}" Width="10" Height="10" Margin="0,0,10,0"/>
          <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="700" Foreground="{StaticResource PlayKrossText}"><TextBlock.Text><MultiBinding Converter="{StaticResource Translate}"><Binding Path="Status"/><Binding Source="{x:Static local:Language.Current}" Path="Selected"/></MultiBinding></TextBlock.Text></TextBlock>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
