<Application x:Class="PlayKross.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- Brand palette: navy #0E182A, yellow #FFDE5A, blue #6A94C5 (shared with the website). -->
    <SolidColorBrush x:Key="PlayKrossBackground" Color="#0E182A"/>
    <SolidColorBrush x:Key="PlayKrossBackgroundDeep" Color="#0A1220"/>
    <SolidColorBrush x:Key="PlayKrossSurface" Color="#132139"/>
    <SolidColorBrush x:Key="PlayKrossSurfaceRaised" Color="#182A45"/>
    <SolidColorBrush x:Key="PlayKrossHover" Color="#1F3555"/>
    <SolidColorBrush x:Key="PlayKrossInput" Color="#0C1626"/>
    <SolidColorBrush x:Key="PlayKrossLine" Color="#22354D"/>
    <SolidColorBrush x:Key="PlayKrossLineStrong" Color="#34506D"/>
    <SolidColorBrush x:Key="PlayKrossText" Color="#EDF2F7"/>
    <SolidColorBrush x:Key="PlayKrossTextSoft" Color="#B9C8DA"/>
    <SolidColorBrush x:Key="PlayKrossMuted" Color="#8396AD"/>
    <SolidColorBrush x:Key="PlayKrossDisabled" Color="#5F7389"/>
    <SolidColorBrush x:Key="PlayKrossBlue" Color="#6A94C5"/>
    <SolidColorBrush x:Key="PlayKrossYellow" Color="#FFDE5A"/>
    <SolidColorBrush x:Key="PlayKrossYellowHover" Color="#FFE785"/>
    <SolidColorBrush x:Key="PlayKrossInk" Color="#152647"/>
    <SolidColorBrush x:Key="PlayKrossLive" Color="#FF5A6A"/>
    <SolidColorBrush x:Key="PlayKrossOk" Color="#5FD08A"/>
    <LinearGradientBrush x:Key="PlayKrossPageBrush" StartPoint="0,0" EndPoint="0.35,1"><GradientStop Color="#13233D" Offset="0"/><GradientStop Color="#0E182A" Offset="0.45"/><GradientStop Color="#0A1220" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PlayKrossCardBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#162741" Offset="0"/><GradientStop Color="#111E33" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PlayKrossAccentLine" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#6A94C5" Offset="0"/><GradientStop Color="#FFDE5A" Offset="1"/></LinearGradientBrush>

    <Style x:Key="PlayKrossWindowStyle" TargetType="Window">
      <Setter Property="Background" Value="{StaticResource PlayKrossBackground}"/><Setter Property="Foreground" Value="{StaticResource PlayKrossText}"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="13.5"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style TargetType="Window" BasedOn="{StaticResource PlayKrossWindowStyle}"/>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="{StaticResource PlayKrossSurfaceRaised}"/><Setter Property="Foreground" Value="{StaticResource PlayKrossText}"/><Setter Property="BorderBrush" Value="{StaticResource PlayKrossLineStrong}"/><Setter Property="Padding" Value="10,6"/></Style>

    <!-- Layout building blocks -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PlayKrossCardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource PlayKrossLine}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20,18"/><Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource PlayKrossText}"/><Setter Property="Margin" Value="0,0,0,2"/></Style>
    <Style x:Key="CardSubtitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource PlayKrossMuted}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="FontSize" Value="12.5"/></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource PlayKrossTextSoft}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,12,0,6"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource PlayKrossMuted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/><Setter Property="Margin" Value="0,10,0,0"/></Style>
    <Style x:Key="Divider" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{StaticResource PlayKrossLine}"/><Setter Property="Margin" Value="0,16,0,4"/></Style>

    <!-- Buttons: secondary by default; Primary (yellow), Danger (red) and Quiet variants. -->
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="36"/>
      <Setter Property="Background" Value="{StaticResource PlayKrossSurfaceRaised}"/><Setter Property="Foreground" Value="{StaticResource PlayKrossText}"/><Setter Property="BorderBrush" Value="{StaticResource PlayKrossLineStrong}"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource PlayKrossHover}"/><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource PlayKrossBlue}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#28466B"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource PlayKrossYellow}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource PlayKrossYellow}"/><Setter Property="Foreground" Value="{StaticResource PlayKrossInk}"/><Setter Property="BorderBrush" Value="{StaticResource PlayKrossYellow}"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
          <Border.Effect><DropShadowEffect Color="#FFDE5A" Opacity="0.22" BlurRadius="18" ShadowDepth="4" Direction="270"/></Border.Effect>
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource PlayKrossYellowHover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#F2CF45"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource PlayKrossText}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter TargetName="Frame" Property="Effect" Value="{x:Null}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#3A1A26"/><Setter Property="Foreground" Value="#FFD9DE"/><Setter Property="BorderBrush" Value="#93404F"/>
    </Style>
    <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource PlayKrossTextSoft}"/><Setter Property="BorderBrush" Value="{StaticResource PlayKrossLine}"/>
    </Style>

    <!-- Text input -->
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,9"/><Setter Property="Background" Value="{StaticResource PlayKrossInput}"/><Setter Property="Foreground" Value="{StaticResource PlayKrossText}"/>
      <Setter Property="CaretBrush" Value="{StaticResource PlayKrossYellow}"/><Setter Property="SelectionBrush" Value="#3B5871"/><Setter Property="BorderBrush" Value="{StaticResource PlayKrossLineStrong}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" SnapsToDevicePixels="True"><ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#46668A"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource PlayKrossYellow}"/></Trigger>
          <Trigger Property="IsReadOnly" Value="True"><Setter Property="Foreground" Value="{StaticResource PlayKrossTextSoft}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Drop-downs -->
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="38"/><Setter Property="Background" Value="{StaticResource PlayKrossInput}"/><Setter Property="Foreground" Value="{StaticResource PlayKrossText}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PlayKrossLineStrong}"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="Toggle" Focusable="False" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press" Cursor="Hand">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" SnapsToDevicePixels="True"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#46668A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="12,8,34,8" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
          <Path Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center" Stroke="{StaticResource PlayKrossTextSoft}" StrokeThickness="1.6" Data="M 0 0 L 4.5 4.5 L 9 0" IsHitTestVisible="False"/>
          <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
            <Border Background="{StaticResource PlayKrossSurfaceRaised}" BorderBrush="{StaticResource PlayKrossLineStrong}" BorderThickness="1" CornerRadius="10" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource PlayKrossYellow}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource PlayKrossText}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Frame" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource PlayKrossHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="#24406A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource PlayKrossDisabled}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

    <!-- Check box -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource PlayKrossTextSoft}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" BorderBrush="{StaticResource PlayKrossLineStrong}" Background="{StaticResource PlayKrossInput}" VerticalAlignment="Top" Margin="0,1,10,0">
            <Path x:Name="Mark" Data="M 3 8 L 6.5 11.5 L 13 4.5" Stroke="{StaticResource PlayKrossInk}" StrokeThickness="2" Visibility="Collapsed" Margin="0,-1,0,0"/></Border>
          <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources></ContentPresenter>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource PlayKrossYellow}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PlayKrossYellow}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PlayKrossBlue}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PlayKrossYellow}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Slider -->
    <Style x:Key="SliderFill" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="5" CornerRadius="2.5" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Slider">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="MinHeight" Value="26"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Track x:Name="PART_Track" VerticalAlignment="Center">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Background="{StaticResource PlayKrossYellow}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Background="{StaticResource PlayKrossLineStrong}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse x:Name="Knob" Width="18" Height="18" Fill="{StaticResource PlayKrossText}" Stroke="{StaticResource PlayKrossYellow}" StrokeThickness="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Thin dark scroll bars -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Bar" Margin="2" CornerRadius="3" Background="#34506D"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#4F6E92"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="2" CornerRadius="3" Background="#34506D"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
